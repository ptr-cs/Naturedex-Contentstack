{
  "name": "naturedex-contentstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "npm run check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:selenium": "node tests/selenium/run.mjs",
    "test:a11y": "playwright test --grep accessibility",
    "verify": "npm run build && npm run test:coverage && npm run test:e2e && npm run test:selenium",
    "cms:pull": "node --env-file-if-exists=.env scripts/contentstack/pull.ts",
    "cms:import": "node --env-file-if-exists=.env scripts/contentstack/import.ts",
    "build:release": "node --env-file-if-exists=.env scripts/release-check.mjs && npm run build && node --env-file-if-exists=.env scripts/scan-release.mjs",
    "sprites:build": "node scripts/build-sprite-animations.mjs",
    "release:scan": "node --env-file-if-exists=.env scripts/scan-release.mjs",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "infra:publish-template": "node scripts/build-publish-template.mjs",
    "setup:publishing": "bash scripts/setup-publishing.sh",
    "test:status": "vitest run --reporter=default --reporter=json --outputFile.json=.cache/status/unit-tests.json"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "astro": "^7.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "^4.10.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "selenium-webdriver": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  }
}
