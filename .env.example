# Copy to .env for CMS commands. Never commit real tokens.
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_ENVIRONMENT=production
CONTENTSTACK_REGION=aws-na
CONTENTSTACK_LOCALE=en-us
# Optional branch; omit to use the stack default branch.
CONTENTSTACK_BRANCH=
# Import only. Do not provide this token to the frontend build or AWS website.
CONTENTSTACK_MANAGEMENT_TOKEN=
# Optional URL of your Contentstack stack's authoring workspace.
CONTENTSTACK_EDITOR_URL=https://app.contentstack.com/
# Used for canonical URLs, sitemap, and feed. Override for the eventual domain.
SITE_URL=http://localhost:4321
