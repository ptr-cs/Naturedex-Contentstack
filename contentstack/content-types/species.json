{
  "content_type": {
    "uid": "species",
    "title": "Species",
    "description": "Naturedex species content. Application validation also checks local assets and cross-entry relationships.",
    "schema": [
      {
        "uid": "title",
        "display_name": "Common name",
        "data_type": "text",
        "mandatory": true,
        "multiple": false,
        "unique": false,
        "field_metadata": {
          "multiline": false,
          "_default": true
        }
      },
      {
        "uid": "stable_id",
        "display_name": "Stable application ID",
        "data_type": "text",
        "mandatory": true,
        "multiple": false,
        "unique": true,
        "field_metadata": {
          "multiline": false
        },
        "format": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
      },
      {
        "uid": "dex_number",
        "display_name": "Field guide number",
        "data_type": "number",
        "mandatory": true,
        "multiple": false,
        "unique": true,
        "field_metadata": {}
      },
      {
        "uid": "scientific_name",
        "display_name": "Scientific name",
        "data_type": "text",
        "mandatory": true,
        "multiple": false,
        "unique": false,
        "field_metadata": {
          "multiline": false
        }
      },
      {
        "uid": "group",
        "display_name": "Animal group",
        "data_type": "text",
        "mandatory": true,
        "multiple": false,
        "unique": false,
        "field_metadata": {
          "multiline": false
        },
        "display_type": "dropdown",
        "enum": {
          "advanced": false,
          "choices": [
            {
              "value": "Mammals"
            },
            {
              "value": "Birds"
            },
            {
              "value": "Reptiles"
            },
            {
              "value": "Amphibians"
            },
            {
              "value": "Fish"
            },
            {
              "value": "Invertebrates"
            }
          ]
        }
      },
      {
        "uid": "sprite",
        "display_name": "Local sprite path",
        "data_type": "text",
        "mandatory": true,
        "multiple": false,
        "unique": false,
        "field_metadata": {
          "multiline": false
        },
        "format": "^/sprites/[a-z0-9-]+\\.svg$"
      },
      {
        "uid": "description",
        "display_name": "Description",
        "data_type": "text",
        "mandatory": true,
        "multiple": false,
        "unique": false,
        "field_metadata": {
          "multiline": true
        }
      },
      {
        "uid": "habitats",
        "display_name": "Habitats",
