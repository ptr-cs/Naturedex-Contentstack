        "multiple": true,
        "unique": false,
        "field_metadata": {
          "multiline": false
        }
      },
      {
        "uid": "diet",
        "display_name": "Diet",
        "data_type": "text",
        "mandatory": true,
        "multiple": true,
        "unique": false,
        "field_metadata": {
          "multiline": false
        }
      },
      {
        "uid": "activity",
        "display_name": "Activity",
