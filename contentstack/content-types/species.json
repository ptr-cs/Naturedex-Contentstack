            "data_type": "number",
            "mandatory": false,
            "multiple": false,
            "unique": false,
            "field_metadata": {}
          },
          {
            "uid": "length_max_cm",
            "display_name": "Maximum length (cm)",
            "data_type": "number",
            "mandatory": false,
            "multiple": false,
            "unique": false,
            "field_metadata": {}
          },
          {
            "uid": "weight_min_kg",
            "display_name": "Minimum weight (kg)",
            "data_type": "number",
            "mandatory": false,
            "multiple": false,
            "unique": false,
            "field_metadata": {}
          },
          {
            "uid": "weight_max_kg",
            "display_name": "Maximum weight (kg)",
            "data_type": "number",
            "mandatory": false,
            "multiple": false,
            "unique": false,
            "field_metadata": {}
          },
          {
            "uid": "note",
            "display_name": "Measurement qualification",
            "data_type": "text",
            "mandatory": false,
            "multiple": false,
            "unique": false,
            "field_metadata": {
              "multiline": true
            }
          }
        ]
      },
      {
