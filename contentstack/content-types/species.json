        "display_name": "Sourced measurements",
        "data_type": "group",
        "mandatory": true,
        "multiple": false,
        "unique": false,
        "field_metadata": {
          "description": "Leave both endpoints empty when a range is unavailable. Include units and source qualifications in the note."
        },
        "schema": [
          {
