---
import Naturedex from '../components/Naturedex';
import Page from '../layouts/Page.astro';
import { readContentSnapshot } from '../lib/content';
import { buildStatus } from '../lib/status';
import { editorUrl } from '../lib/contentstack';

export async function getStaticPaths() {
  const snapshot = readContentSnapshot();
  return [undefined, 'map', 'journal', 'editor', 'about', 'status', ...snapshot.posts.map(post => `journal/${post.slug}`)]
    .map(path => ({ params: { path }, props: { snapshot } }));
}

const { snapshot } = Astro.props;
const currentPath = Astro.params.path ? `/${Astro.params.path}` : '/';
const article = snapshot.posts.find(post => currentPath === `/journal/${post.slug}`);
const title = article?.title || ({ '/': 'Virginia field guide', '/map': 'Region map', '/journal': 'Field journal', '/editor': 'Writing desk', '/about': 'About the field guide', '/status': 'System status' }[currentPath] ?? 'Naturedex');
// Shell variables (CI) override .env (local), matching Vite's own precedence.
const cmsUrl = editorUrl({ ...import.meta.env, ...process.env });
const status = currentPath === '/status' ? buildStatus(snapshot) : undefined;
---
<Page title={title} description={article?.excerpt} noindex={currentPath === '/editor' || currentPath === '/status'}>
  <Naturedex client:load species={snapshot.species} posts={snapshot.posts} initialPath={currentPath} cmsUrl={cmsUrl} status={status} />
</Page>
